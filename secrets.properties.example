# Template for the Supabase credentials. Copy this file to `secrets.properties`
# (which is gitignored) and fill in the real values.
#
# Where to find them: Supabase dashboard -> Project Settings -> API.
# The anon (public) key is designed to ship in the client (guarded by Row Level
# Security), so it is safe there; we still keep it out of version control.
# NEVER put the service_role key here — it bypasses RLS.
supabase.url=https://YOUR-PROJECT.supabase.co
supabase.anonKey=YOUR-ANON-KEY
