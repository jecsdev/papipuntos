<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  OAuth redirect target: usify://auth-callback. Must stay in sync with the scheme/host in
	  SupabaseClientProvider.kt and the Redirect URL registered in the Supabase dashboard.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jecsdev.papipuntos.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>usify</string>
			</array>
		</dict>
	</array>
</dict>
</plist>